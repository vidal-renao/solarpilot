# Postgres. En Supabase hay que usar el agrupador (puerto 6543), no la
# conexion directa: esta solo resuelve a IPv6 y las funciones sin servidor
# no salen por ahi de forma fiable.
#
# El usuario lleva el identificador del proyecto: postgres.<ref>
DATABASE_URL=postgresql://postgres.<ref>:<contrasena>@aws-1-<region>.pooler.supabase.com:6543/postgres

# PVGIS (Comision Europea). Publico, sin clave.
PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_2

# Nominatim no exige clave pero si un User-Agent identificable.
GEOCODER_USER_AGENT=solarpilot-portfolio-demo

# Opcional. Sin definir, la fuente automatica de datos de cubierta queda
# apagada y el sistema cae a la superficie que declare el usuario.
# GOOGLE_SOLAR_API_KEY=
